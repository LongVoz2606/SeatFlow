#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper Script
# ----------------------------------------------------------------------------

PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done

PRGDIR=`dirname "$PRG"`
BASE_DIR=`cd "$PRGDIR" >/dev/null; pwd`

# If system mvn is installed, use it directly
if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    mkdir -p "$BASE_DIR/.mvn/wrapper"
    if command -v curl >/dev/null 2>&1; then
        curl -sS -L -o "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar
    fi
fi

if [ -f "$WRAPPER_JAR" ]; then
    exec java -cp "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
else
    echo "Error: Could not find or download maven-wrapper.jar and system mvn is not installed."
    exit 1
fi
