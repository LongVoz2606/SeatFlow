# Copy file này thành ".env" ở cùng thư mục rồi điền giá trị thật.
# docker-compose sẽ tự động đọc file ".env" khi chạy `docker-compose up`.

# Google OAuth Client ID — lấy tại https://console.cloud.google.com/apis/credentials
# (Tạo "OAuth 2.0 Client ID", loại "Web application", thêm http://localhost và http://localhost:3000
# vào "Authorized JavaScript origins").
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Facebook App ID — lấy tại https://developers.facebook.com/apps
# (Tạo App, bật sản phẩm "Facebook Login", thêm http://localhost vào "App Domains").
VITE_FACEBOOK_APP_ID=

# Gửi email OTP (quên mật khẩu / đổi mật khẩu) — dùng Gmail SMTP.
# Bật xác minh 2 bước cho tài khoản Gmail, rồi tạo "Mật khẩu ứng dụng" tại
# https://myaccount.google.com/apppasswords (chọn app "Mail"), dán chuỗi 16 ký tự vào MAIL_PASSWORD.
# Nếu để trống, hệ thống sẽ chỉ log mã OTP ra console thay vì gửi email thật (dùng để test local).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SeatFlow <no-reply@seatflow.com>

# Gửi SMS OTP (quên mật khẩu) — dùng Twilio.
# Lấy Account SID + Auth Token tại https://console.twilio.com, mua/lấy số điện thoại dùng thử
# tại https://console.twilio.com/us1/develop/phone-numbers/manage/incoming rồi điền vào TWILIO_FROM_NUMBER
# (dạng +1xxxxxxxxxx). Tài khoản Twilio Trial chỉ gửi được tới các số đã "Verified Caller ID".
# Nếu để trống, hệ thống sẽ chỉ log mã OTP ra console thay vì gửi SMS thật (dùng để test local).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
